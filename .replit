modules = ["nodejs-20", "web", "bash", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["env", "NODE_ENV=production", "node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["pnpm", "run", "build:deploy"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/wedding-invite: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/wedding-invite"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/wedding-invite run dev"
cwd = "./artifacts/wedding-invite"
waitForPort = 24366
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "24366"
BASE_PATH = "/"
VITE_R2_DOMAIN_URL = "https://pub-481ad7c8cfa7476cab2b1b405062a026.r2.dev/"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/wedding-invite: web"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 8084
externalPort = 3003

[[ports]]
localPort = 8085
externalPort = 4200

[[ports]]
localPort = 8086
externalPort = 5173

[[ports]]
localPort = 24366
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SEED_SECRET = "wib123456!87"
PORT = "5000"
BASE_PATH = "/"
API_PORT = "8080"
VITE_R2_DOMAIN_URL = "https://pub-da9ec13fc33b409985c91f43625efdb4.r2.dev"
TOYYIBPAY_CATEGORY_CODE = "8bw99mw0"
TOYYIBPAY_SANDBOX = "true"
TOYYIBPAY_PUBLIC_BASE_URL = "https://wedinstudio.com"
TOYYIBPAY_DUITNOW_QR_ENABLED = "true"

[userenv.development]
CF_R2_BUCKET_NAME_DEVELOPMENT = "wedinbytes"

[userenv.production]
CF_R2_BUCKET_NAME_PRODUCTION = "wedinstudio"
